PORT=8080
APP_ENV=development
DATABASE_URL=postgres://interviewprep:interviewprep@localhost:5432/interviewprep?sslmode=disable
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
POST_LOGIN_REDIRECT=/

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# JWT / session
# JWT_SECRET must be at least 32 random bytes in production. Generate with:
#   openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Cookies — set COOKIE_SECURE=true in production (requires HTTPS).
# COOKIE_DOMAIN can stay empty for host-only cookies.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Google Cloud / Vertex AI — leave AGENT_ENABLED=false for local dev
# (stub reviewer + stub STT are used so the end-to-end flow still works).
# To enable real AI:
#   1) Run: gcloud auth application-default login
#   2) Or set GOOGLE_APPLICATION_CREDENTIALS to a service account JSON
#   3) Set AGENT_ENABLED=true and GOOGLE_CLOUD_PROJECT
AGENT_ENABLED=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
AGENT_MODEL=gemini-2.5-flash
STT_LANGUAGE=en-US

# Premium Gemini API path used for paid (Pro) users. Free users continue
# to hit Vertex AI with AGENT_MODEL (above). Leave GEMINI_API_KEY empty
# and Pro users transparently fall back to the Vertex agent.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_PREMIUM_MODEL=gemini-2.5-pro

# Audio
AUDIO_LOCAL_DIR=./var/audio
MAX_AUDIO_BYTES=15728640

# Reference-answer TTS (Google Cloud Text-to-Speech + Cloud Storage).
# Run `./scripts/setup-audio-bucket.sh` to create the bucket. GCS doesn't
# accept "global" as a location (Vertex AI does), so AUDIO_BUCKET_LOCATION
# is separate from GOOGLE_CLOUD_LOCATION.
AUDIO_BUCKET=
AUDIO_BUCKET_LOCATION=us-central1
TTS_VOICE=en-US-Neural2-D
# Voice for the interviewer reading the question aloud in live interviews
# (different from TTS_VOICE so the candidate hears two distinct speakers).
# Neural2-F is a natural-sounding female voice; see
# https://cloud.google.com/text-to-speech/docs/voices for alternatives.
TTS_PROMPT_VOICE=en-US-Neural2-F

# Resume upload
MAX_RESUME_BYTES=10485760

# Admin allow-list. Comma-separated emails (case-insensitive) that may create
# new topics/skills via POST /api/v1/categories.
ADMIN_EMAILS=

# Razorpay Subscriptions — see https://dashboard.razorpay.com/app/keys
# and https://dashboard.razorpay.com/app/subscriptions/plans
# Leave empty to disable payments (checkout returns 503, webhook is unmounted).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret is configured separately in Razorpay dashboard under
# Settings → Webhooks. Used to HMAC-verify every webhook call.
RAZORPAY_WEBHOOK_SECRET=
# Razorpay Plan IDs (create one Plan per pricing tier in the dashboard).
# Monthly = $25/month, biannual = $100 every 6 months (period=monthly, interval=6).
RAZORPAY_PLAN_MONTHLY_ID=
RAZORPAY_PLAN_BIANNUAL_ID=
