# Database
DB_HOST=db
DB_PORT=5432
DB_USER=interviewprep
DB_PASSWORD=interviewprep
DB_NAME=interviewprep
DB_SSLMODE=disable

# Backend
SERVER_PORT=8080
APP_ENV=development
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
POST_LOGIN_REDIRECT=/

# Auth — Google OAuth (create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Auth — JWT/session
# JWT_SECRET must be at least 32 random bytes in production. Generate with:
#   openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# In production: COOKIE_SECURE=true and serve over HTTPS. COOKIE_DOMAIN can be left blank for host-only cookies.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_AUTH_BASE_URL=/auth
